# Public, browser-visible frontend settings only.
# Vite embeds every VITE_* variable into the client bundle, so NEVER put
# API keys, tokens, or secrets in this file.
VITE_API_BASE_URL=http://localhost:5000/api

# true  = labelled demo data, no API needed (default)
# false = call the live Flask API
# On Render this is set in render.yaml; real env vars override this file.
VITE_USE_SAMPLE_DATA=true
