# ---------------------------------------------------------------------------
# Fake News Detection API - local environment template
# Copy this file to .env and fill in local values. NEVER commit .env.
# ---------------------------------------------------------------------------

FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Generate a value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Google Gemini - BACKEND ONLY. Never expose this key to the frontend.
# Leave empty until you are ready to enable live analysis in Phase 2.
# Without a key the API falls back to a simple local heuristic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq - BACKEND ONLY. Alternative AI provider (https://console.groq.com).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Which AI provider runs analysis: auto | gemini | groq | heuristic
# auto = Gemini if its key is set, else Groq, else the local heuristic.
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=30

# Article fetching (POST /api/analyze-url)
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_BYTES=2097152

# Origins allowed to call /api/* (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Relative paths resolve from the backend/ directory.
DATABASE_PATH=instance/fakenews.db
